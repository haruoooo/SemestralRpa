# Product API: "http" (real API or local mock) or "file" (structured JSON files)
PRODUCT_API_MODE=http
PRODUCT_API_URL=http://127.0.0.1:8000
PRODUCT_API_KEY=

# Line status source: "metroWebsite" (live) or "simulated" (demo scenario file)
LINE_STATUS_SOURCE=metroWebsite
METRO_STATUS_URL=https://www.metro.sp.gov.br/wp-content/themes/metrosp/direto-metro.php
SIMULATED_SCENARIO_PATH=data/runtime/simulatedScenario.json

# Monitor rules (RN16, RN17)
MONITORED_LINES=1,3
MONITOR_START=05:00
MONITOR_END=22:00
STALE_AFTER_MINUTES=30

# Resilience (EX06, EX09)
HTTP_TIMEOUT_SECONDS=15
RETRY_ATTEMPTS=3

# Local paths
STATE_DB_PATH=data/runtime/robotState.db
FILE_API_OUTPUT_DIR=data/runtime/fileApi
LOG_DIR=logs

# scheduleImportFlow: HR drop folder, HR reports and Big Data landing zone
INPUT_DIR=data/input
REPORT_DIR=data/output/reports
LANDING_ZONE_PATH=landingZone/chegada

# LGPD: salt used to hash employee ids in logs (any long random string)
LOG_SALT=

# E-mail (agendaDispatchFlow): "smtp" (Mailtrap sandbox) or "console" (prints instead of sending)
NOTIFIER_MODE=console
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="ForaDoPico <agenda@foradopico.example>"
