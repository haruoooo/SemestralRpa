<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="agendaDispatchFlowDefinitions" targetNamespace="https://github.com/haruoooo/SemestralRpa" exporter="tools.bpmnDiagrams" exporterVersion="1.0">
<bpmn:collaboration id="agendaDispatchFlowCollaboration"><bpmn:participant id="agendaDispatchFlowPool" name="Fluxo 2 · agendaDispatchFlow" processRef="agendaDispatchFlowProcess"/><bpmn:participant id="mailPool" name="Servidor de e-mail (Mailtrap) → funcionário"/><bpmn:participant id="apiPool" name="API do ForaDoPico"/><bpmn:messageFlow id="message0" name="GET /schedules, GET /contingencyPlans" sourceRef="fetch" targetRef="apiPool"/><bpmn:messageFlow id="message1" name="E-mail + agenda.ics" sourceRef="sendMail" targetRef="mailPool"/><bpmn:messageFlow id="message2" name="POST /dispatches" sourceRef="reportApi" targetRef="apiPool"/></bpmn:collaboration>
<bpmn:process id="agendaDispatchFlowProcess" name="Fluxo 2 · agendaDispatchFlow" isExecutable="false"><bpmn:laneSet id="agendaDispatchFlowLanes"><bpmn:lane id="hr" name="RH"><bpmn:flowNodeRef>hrStart</bpmn:flowNodeRef><bpmn:flowNodeRef>hrApprove</bpmn:flowNodeRef><bpmn:flowNodeRef>hrEnd</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="robot" name="Robô RPA"><bpmn:flowNodeRef>timer</bpmn:flowNodeRef><bpmn:flowNodeRef>outbox</bpmn:flowNodeRef><bpmn:flowNodeRef>fetch</bpmn:flowNodeRef><bpmn:flowNodeRef>apiUp</bpmn:flowNodeRef><bpmn:flowNodeRef>apiDown</bpmn:flowNodeRef><bpmn:flowNodeRef>reportApi</bpmn:flowNodeRef><bpmn:flowNodeRef>reportUp</bpmn:flowNodeRef><bpmn:flowNodeRef>reportQueue</bpmn:flowNodeRef><bpmn:flowNodeRef>summary</bpmn:flowNodeRef><bpmn:flowNodeRef>end</bpmn:flowNodeRef><bpmn:flowNodeRef>sp2</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
<bpmn:subProcess id="sp2" name="Para cada escala e plano B aprovado, para cada funcionário"><bpmn:incoming>flow6</bpmn:incoming><bpmn:outgoing>flow15</bpmn:outgoing><bpmn:multiInstanceLoopCharacteristics isSequential="true"/><bpmn:startEvent id="itemStart" name="Funcionário"><bpmn:outgoing>flow7</bpmn:outgoing></bpmn:startEvent><bpmn:exclusiveGateway id="already" name="Já recebeu esta versão? (RN11)"><bpmn:incoming>flow7</bpmn:incoming><bpmn:outgoing>flow8</bpmn:outgoing><bpmn:outgoing>flow9</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="skipEnd" name="Pulado"><bpmn:incoming>flow8</bpmn:incoming></bpmn:endEvent><bpmn:task id="compose" name="Montar e-mail e anexo .ics"><bpmn:incoming>flow9</bpmn:incoming><bpmn:outgoing>flow10</bpmn:outgoing></bpmn:task><bpmn:sendTask id="sendMail" name="Enviar e-mail (3 tentativas)"><bpmn:incoming>flow10</bpmn:incoming><bpmn:outgoing>flow11</bpmn:outgoing></bpmn:sendTask><bpmn:exclusiveGateway id="mailUp" name="Servidor de e-mail respondeu?"><bpmn:incoming>flow11</bpmn:incoming><bpmn:outgoing>flow12</bpmn:outgoing><bpmn:outgoing>flow13</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="stop" name="Parar os envios; restante fica pendente (EX08)"><bpmn:incoming>flow12</bpmn:incoming><bpmn:errorEventDefinition id="error_stop"/></bpmn:endEvent><bpmn:task id="record" name="Gravar o envio no estado do robô"><bpmn:incoming>flow13</bpmn:incoming><bpmn:outgoing>flow14</bpmn:outgoing></bpmn:task><bpmn:endEvent id="sentEnd" name="Enviado"><bpmn:incoming>flow14</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="flow7" sourceRef="itemStart" targetRef="already"/><bpmn:sequenceFlow id="flow8" name="Sim" sourceRef="already" targetRef="skipEnd"/><bpmn:sequenceFlow id="flow9" name="Não" sourceRef="already" targetRef="compose"/><bpmn:sequenceFlow id="flow10" sourceRef="compose" targetRef="sendMail"/><bpmn:sequenceFlow id="flow11" sourceRef="sendMail" targetRef="mailUp"/><bpmn:sequenceFlow id="flow12" name="Não" sourceRef="mailUp" targetRef="stop"/><bpmn:sequenceFlow id="flow13" name="Sim" sourceRef="mailUp" targetRef="record"/><bpmn:sequenceFlow id="flow14" sourceRef="record" targetRef="sentEnd"/></bpmn:subProcess>
<bpmn:startEvent id="hrStart" name="Escala ou plano B pendente"><bpmn:outgoing>flow0</bpmn:outgoing><bpmn:messageEventDefinition id="message_hrStart"/></bpmn:startEvent>
<bpmn:userTask id="hrApprove" name="Revisar e aprovar no app (RN10)"><bpmn:incoming>flow0</bpmn:incoming><bpmn:outgoing>flow1</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="hrEnd" name="Aprovado"><bpmn:incoming>flow1</bpmn:incoming></bpmn:endEvent>
<bpmn:startEvent id="timer" name="A cada 10 min"><bpmn:outgoing>flow2</bpmn:outgoing><bpmn:timerEventDefinition id="timer_timer"><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT10M</bpmn:timeCycle></bpmn:timerEventDefinition></bpmn:startEvent>
<bpmn:serviceTask id="outbox" name="Reenviar relatórios de envio da outbox"><bpmn:incoming>flow2</bpmn:incoming><bpmn:outgoing>flow3</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="fetch" name="Buscar escalas e planos B aprovados"><bpmn:incoming>flow3</bpmn:incoming><bpmn:outgoing>flow4</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="apiUp" name="API respondeu?"><bpmn:incoming>flow4</bpmn:incoming><bpmn:outgoing>flow5</bpmn:outgoing><bpmn:outgoing>flow6</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="apiDown" name="Tentar na próxima execução (EX06)"><bpmn:incoming>flow5</bpmn:incoming></bpmn:endEvent>
<bpmn:serviceTask id="reportApi" name="Informar resultados à API"><bpmn:incoming>flow15</bpmn:incoming><bpmn:outgoing>flow16</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="reportUp" name="API respondeu?"><bpmn:incoming>flow16</bpmn:incoming><bpmn:outgoing>flow17</bpmn:outgoing><bpmn:outgoing>flow18</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="reportQueue" name="Guardar relatório na outbox"><bpmn:incoming>flow18</bpmn:incoming><bpmn:outgoing>flow19</bpmn:outgoing></bpmn:task>
<bpmn:task id="summary" name="Registrar o resumo da execução"><bpmn:incoming>flow17</bpmn:incoming><bpmn:incoming>flow19</bpmn:incoming><bpmn:outgoing>flow20</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="end" name="Fim"><bpmn:incoming>flow20</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="flow0" sourceRef="hrStart" targetRef="hrApprove"/>
<bpmn:sequenceFlow id="flow1" sourceRef="hrApprove" targetRef="hrEnd"/>
<bpmn:sequenceFlow id="flow2" sourceRef="timer" targetRef="outbox"/>
<bpmn:sequenceFlow id="flow3" sourceRef="outbox" targetRef="fetch"/>
<bpmn:sequenceFlow id="flow4" sourceRef="fetch" targetRef="apiUp"/>
<bpmn:sequenceFlow id="flow5" name="Não" sourceRef="apiUp" targetRef="apiDown"/>
<bpmn:sequenceFlow id="flow6" name="Sim" sourceRef="apiUp" targetRef="sp2"/>
<bpmn:sequenceFlow id="flow15" sourceRef="sp2" targetRef="reportApi"/>
<bpmn:sequenceFlow id="flow16" sourceRef="reportApi" targetRef="reportUp"/>
<bpmn:sequenceFlow id="flow17" name="Sim" sourceRef="reportUp" targetRef="summary"/>
<bpmn:sequenceFlow id="flow18" name="Não (EX06)" sourceRef="reportUp" targetRef="reportQueue"/>
<bpmn:sequenceFlow id="flow19" sourceRef="reportQueue" targetRef="summary"/>
<bpmn:sequenceFlow id="flow20" sourceRef="summary" targetRef="end"/>
<bpmn:textAnnotation id="notePlan"><bpmn:text>Plano B aprovado: o .ics cancela (remoto) ou move (nova janela) o mesmo evento da agenda da semana.</bpmn:text></bpmn:textAnnotation>
</bpmn:process>
