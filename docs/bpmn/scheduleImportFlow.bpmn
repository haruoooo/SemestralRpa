<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="scheduleImportFlowDefinitions" targetNamespace="https://github.com/haruoooo/SemestralRpa" exporter="tools.bpmnDiagrams" exporterVersion="1.0">
<bpmn:collaboration id="scheduleImportFlowCollaboration"><bpmn:participant id="scheduleImportFlowPool" name="Fluxo 1 · scheduleImportFlow" processRef="scheduleImportFlowProcess"/><bpmn:participant id="apiPool" name="API do ForaDoPico"/><bpmn:messageFlow id="message0" name="POST /scheduleImports" sourceRef="outbox" targetRef="apiPool"/><bpmn:messageFlow id="message1" name="POST /scheduleImports" sourceRef="send" targetRef="apiPool"/></bpmn:collaboration>
<bpmn:process id="scheduleImportFlowProcess" name="Fluxo 1 · scheduleImportFlow" isExecutable="false"><bpmn:laneSet id="scheduleImportFlowLanes"><bpmn:lane id="hr" name="RH"><bpmn:flowNodeRef>hrStart</bpmn:flowNodeRef><bpmn:flowNodeRef>hrFill</bpmn:flowNodeRef><bpmn:flowNodeRef>hrSave</bpmn:flowNodeRef><bpmn:flowNodeRef>hrEnd</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="robot" name="Robô RPA"><bpmn:flowNodeRef>timer</bpmn:flowNodeRef><bpmn:flowNodeRef>outbox</bpmn:flowNodeRef><bpmn:flowNodeRef>list</bpmn:flowNodeRef><bpmn:flowNodeRef>hasFiles</bpmn:flowNodeRef><bpmn:flowNodeRef>noFiles</bpmn:flowNodeRef><bpmn:flowNodeRef>summary</bpmn:flowNodeRef><bpmn:flowNodeRef>end</bpmn:flowNodeRef><bpmn:flowNodeRef>sp1</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
<bpmn:subProcess id="sp1" name="Para cada arquivo"><bpmn:incoming>flow7</bpmn:incoming><bpmn:outgoing>flow23</bpmn:outgoing><bpmn:multiInstanceLoopCharacteristics isSequential="true"/><bpmn:startEvent id="fileStart" name="Arquivo"><bpmn:outgoing>flow8</bpmn:outgoing></bpmn:startEvent><bpmn:task id="hash" name="Calcular o hash SHA-256"><bpmn:incoming>flow8</bpmn:incoming><bpmn:outgoing>flow9</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="isDuplicate" name="Já importado? (RN02)"><bpmn:incoming>flow9</bpmn:incoming><bpmn:outgoing>flow10</bpmn:outgoing><bpmn:outgoing>flow12</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="moveDuplicate" name="Mover para rejected/duplicates/"><bpmn:incoming>flow10</bpmn:incoming><bpmn:outgoing>flow11</bpmn:outgoing></bpmn:task><bpmn:endEvent id="duplicateEnd" name="Ignorado"><bpmn:incoming>flow11</bpmn:incoming></bpmn:endEvent><bpmn:task id="validate" name="Abrir e validar abas, colunas e linhas (RN01, RN03 a RN08)"><bpmn:incoming>flow12</bpmn:incoming><bpmn:outgoing>flow13</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="isAccepted" name="Dentro do limite? (RN09)"><bpmn:incoming>flow13</bpmn:incoming><bpmn:outgoing>flow14</bpmn:outgoing><bpmn:outgoing>flow16</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="reject" name="Gerar relatório do RH e mover para rejected/ (EX02 a EX04)"><bpmn:incoming>flow14</bpmn:incoming><bpmn:outgoing>flow15</bpmn:outgoing></bpmn:task><bpmn:endEvent id="rejectEnd" name="Rejeitada"><bpmn:incoming>flow15</bpmn:incoming></bpmn:endEvent><bpmn:serviceTask id="send" name="Enviar à API com Idempotency-Key (3 tentativas)"><bpmn:incoming>flow16</bpmn:incoming><bpmn:outgoing>flow17</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="apiAnswered" name="API respondeu?"><bpmn:incoming>flow17</bpmn:incoming><bpmn:outgoing>flow18</bpmn:outgoing><bpmn:outgoing>flow19</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="queue" name="Guardar na outbox"><bpmn:incoming>flow19</bpmn:incoming><bpmn:outgoing>flow20</bpmn:outgoing></bpmn:task><bpmn:serviceTask id="land" name="Gravar lote pseudonimizado na pasta de pouso"><bpmn:incoming>flow18</bpmn:incoming><bpmn:incoming>flow20</bpmn:incoming><bpmn:outgoing>flow21</bpmn:outgoing><bpmn:dataOutputAssociation id="assoc_land_landingStore"><bpmn:targetRef>landingStore</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask><bpmn:task id="report" name="Gerar relatório do RH e mover para processed/"><bpmn:incoming>flow21</bpmn:incoming><bpmn:outgoing>flow22</bpmn:outgoing></bpmn:task><bpmn:endEvent id="importedEnd" name="Importada"><bpmn:incoming>flow22</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="flow8" sourceRef="fileStart" targetRef="hash"/><bpmn:sequenceFlow id="flow9" sourceRef="hash" targetRef="isDuplicate"/><bpmn:sequenceFlow id="flow10" name="Sim" sourceRef="isDuplicate" targetRef="moveDuplicate"/><bpmn:sequenceFlow id="flow11" sourceRef="moveDuplicate" targetRef="duplicateEnd"/><bpmn:sequenceFlow id="flow12" name="Não" sourceRef="isDuplicate" targetRef="validate"/><bpmn:sequenceFlow id="flow13" sourceRef="validate" targetRef="isAccepted"/><bpmn:sequenceFlow id="flow14" name="Não" sourceRef="isAccepted" targetRef="reject"/><bpmn:sequenceFlow id="flow15" sourceRef="reject" targetRef="rejectEnd"/><bpmn:sequenceFlow id="flow16" name="Sim" sourceRef="isAccepted" targetRef="send"/><bpmn:sequenceFlow id="flow17" sourceRef="send" targetRef="apiAnswered"/><bpmn:sequenceFlow id="flow18" name="Sim" sourceRef="apiAnswered" targetRef="land"/><bpmn:sequenceFlow id="flow19" name="Não (EX06)" sourceRef="apiAnswered" targetRef="queue"/><bpmn:sequenceFlow id="flow20" sourceRef="queue" targetRef="land"/><bpmn:sequenceFlow id="flow21" sourceRef="land" targetRef="report"/><bpmn:sequenceFlow id="flow22" sourceRef="report" targetRef="importedEnd"/></bpmn:subProcess>
<bpmn:startEvent id="hrStart" name="Escala da semana definida"><bpmn:outgoing>flow0</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="hrFill" name="Preencher a planilha no modelo do RH"><bpmn:incoming>flow0</bpmn:incoming><bpmn:outgoing>flow1</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="hrSave" name="Salvar em data/input/"><bpmn:incoming>flow1</bpmn:incoming><bpmn:outgoing>flow2</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="hrEnd" name="Planilha entregue ao robô"><bpmn:incoming>flow2</bpmn:incoming></bpmn:endEvent>
<bpmn:startEvent id="timer" name="A cada 5 min"><bpmn:outgoing>flow3</bpmn:outgoing><bpmn:timerEventDefinition id="timer_timer"><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT5M</bpmn:timeCycle></bpmn:timerEventDefinition></bpmn:startEvent>
<bpmn:serviceTask id="outbox" name="Reenviar importações da outbox (EX06)"><bpmn:incoming>flow3</bpmn:incoming><bpmn:outgoing>flow4</bpmn:outgoing></bpmn:serviceTask>
<bpmn:task id="list" name="Listar arquivos em data/input/"><bpmn:incoming>flow4</bpmn:incoming><bpmn:outgoing>flow5</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="hasFiles" name="Há arquivos?"><bpmn:incoming>flow5</bpmn:incoming><bpmn:outgoing>flow6</bpmn:outgoing><bpmn:outgoing>flow7</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="noFiles" name="Nada a processar"><bpmn:incoming>flow6</bpmn:incoming></bpmn:endEvent>
<bpmn:task id="summary" name="Registrar o resumo da execução (RunSummary)"><bpmn:incoming>flow23</bpmn:incoming><bpmn:outgoing>flow24</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="end" name="Fim"><bpmn:incoming>flow24</bpmn:incoming></bpmn:endEvent>
<bpmn:dataStoreReference id="landingStore" name="Pasta de pouso (Big Data)"/>
<bpmn:sequenceFlow id="flow0" sourceRef="hrStart" targetRef="hrFill"/>
<bpmn:sequenceFlow id="flow1" sourceRef="hrFill" targetRef="hrSave"/>
<bpmn:sequenceFlow id="flow2" sourceRef="hrSave" targetRef="hrEnd"/>
<bpmn:sequenceFlow id="flow3" sourceRef="timer" targetRef="outbox"/>
<bpmn:sequenceFlow id="flow4" sourceRef="outbox" targetRef="list"/>
<bpmn:sequenceFlow id="flow5" sourceRef="list" targetRef="hasFiles"/>
<bpmn:sequenceFlow id="flow6" name="Não" sourceRef="hasFiles" targetRef="noFiles"/>
<bpmn:sequenceFlow id="flow7" name="Sim" sourceRef="hasFiles" targetRef="sp1"/>
<bpmn:sequenceFlow id="flow23" sourceRef="sp1" targetRef="summary"/>
<bpmn:sequenceFlow id="flow24" sourceRef="summary" targetRef="end"/>
<bpmn:textAnnotation id="noteReport"><bpmn:text>Planilha rejeitada: o RH lê o relatório importReport&lt;hash&gt;.xlsx (aba, linha, coluna e motivo), corrige e salva de novo.</bpmn:text></bpmn:textAnnotation>
</bpmn:process>
